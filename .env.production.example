# ─── Configuration PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=stocktn_admin
POSTGRES_PASSWORD=RemplacerParUnMotDePasseTresSecurise2026!
POSTGRES_DB=stocktn_production

# ─── Sécurité JWT (Générez des chaînes aléatoires longues) ───────────────────
JWT_SECRET=CleSecreteTresLonguePourAccessToken_2026_Minimum32Caracteres!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CleSecreteTresLonguePourRefreshToken_2026_Minimum32Caracteres!
JWT_REFRESH_EXPIRES_IN=7d

# ─── Configuration Email SMTP (Optionnel mais recommandé pour les alertes) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application-gmail
SMTP_FROM="StockTN <contact@votre-domaine.com>"

# ─── Domaine de l'application ───────────────────────────────────────────────
# Mettez l'adresse IP publique de votre VM Oracle ou votre nom de domaine
FRONTEND_URL=http://VOTRE_IP_ORACLE_OU_DOMAINE
