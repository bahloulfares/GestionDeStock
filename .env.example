# ======================================================
# SaaS Gestion de Stocks — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
# ======================================================

# ---- Base de données ----
POSTGRES_USER=mvp_user
POSTGRES_PASSWORD=mvp_secret_2026
POSTGRES_DB=mvp_stocks
DATABASE_URL="postgresql://mvp_user:mvp_secret_2026@localhost:5432/mvp_stocks?schema=public"

# ---- JWT ----
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_base64_64_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ---- Application ----
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ---- CORS ----
# Séparés par virgule : http://localhost:5173,https://votredomaine.tn
CORS_ORIGINS=http://localhost:5173

# ---- pgAdmin (Docker) ----
PGADMIN_EMAIL=admin@mvp.local
PGADMIN_PASSWORD=admin123

# ---- Email (Nodemailer) ----
# En dev, mettre DEV_BYPASS_EMAIL=true pour désactiver la vérification email
DEV_BYPASS_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre@email.com
SMTP_PASS=votre_app_password
SMTP_FROM="StockTN <noreply@votre-domaine.tn>"

# ---- Frontend (référence uniquement) ----
VITE_API_URL=http://localhost:3000/api
# ---- Proxy (production uniquement) ----
# Nombre de proxys de confiance devant l'application.
#   1 = un seul Nginx (defaut)
#   2 = Nginx + Cloudflare ou load balancer
#   0 = pas de proxy (dev local, ignore si NODE_ENV != production)
TRUST_PROXY_HOPS=1
